{
  "name": "occupational-health-system",
  "version": "1.0.0",
  "private": true,
  "description": "职业金属复合暴露智能干预推荐与决策支持系统",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd my-nuxt-app && pnpm dev",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload --port 8000",
    "install:all": "cd my-nuxt-app && pnpm install && cd ../backend && pip install -r requirements.txt",
    "install:frontend": "cd my-nuxt-app && pnpm install",
    "install:backend": "cd backend && pip install -r requirements.txt"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

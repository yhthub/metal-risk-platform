# Copy to a private file OUTSIDE the repository. Never commit actual keys.
# Paths below are placeholders, not directories created or copied by this implementation.
TARGET_SERVER_IP=8.148.158.242
# This is an IP, not a domain. The real domain has NOT yet been supplied.
DOMAIN_NAME=REPLACE_WITH_REAL_DOMAIN
RAG_CORPUS_HOST_PATH=/srv/occupational-health/corpus/immutable-generation
RAG_MODEL_HOST_PATH=/srv/occupational-health/models/Llama-3.1-8B
# No ANN file was found in the bounded local inventory. These are FUTURE placeholders.
RAG_DENSE_INDEX_HOST_PATH=/srv/occupational-health/indexes/closed-medcpt-generation
RAG_DENSE_INDEX_FILENAME=medcpt_ivfpq.faiss
# Explicitly true only for an approved CPU MedCPT/FAISS build. Default never silently installs Torch.
INSTALL_MEDCPT=false
RAG_RETRIEVAL_MODE=hybrid
RAG_ALLOW_DEGRADED_RETRIEVAL=false
RAG_CANDIDATE_K=32
# Approx. 1.7GB compressed ANN planning needs more than the API's old 512MiB default.
# 2GiB is a declared index-file budget, not peak RAM or accuracy assurance.
RAG_DENSE_MAX_INDEX_BYTES=2147483648
RAG_DENSE_NPROBE=32
RAG_DENSE_TIMEOUT_SECONDS=20
RAG_PUBLIC_ORIGIN=https://rag.example.org
RAG_API_KEY=REPLACE_WITH_RANDOM_HEX_KEY_AT_LEAST_32_CHARACTERS
RAG_LLM_API_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_HEX_KEY
RAG_LLM_MODEL=Llama-3.1-8B
RAG_LLM_TIMEOUT_SECONDS=180
RAG_LLM_MAX_TOKENS=768
RAG_LLM_CONTEXT_CHARS=18000
RAG_TOP_K=8
RAG_MAX_CONCURRENT_GENERATIONS=1
RAG_RATE_LIMIT_PER_MINUTE=20
RAG_WEB_PORT=8080
# edge-compose only: no default backend. Use a separately authorized RAG node.
RAG_API_ORIGIN=https://REPLACE_WITH_PROTECTED_RAG_NODE
RAG_API_HOST=REPLACE_WITH_PROTECTED_RAG_NODE
RAG_WEB_IMAGE=REPLACE_WITH_PREBUILT_WEB_IMAGE_AND_PINNED_TAG_OR_DIGEST
# Mandatory: verify GPU/CUDA compatibility and pin an image before startup.
VLLM_IMAGE=vllm/vllm-openai:REPLACE_WITH_TESTED_VERSION_OR_DIGEST
VLLM_GPU_COUNT=1
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_DTYPE=auto
VLLM_MAX_MODEL_LEN=8192
# compose derives RAG_LLM_CONTEXT_WINDOW from VLLM_MAX_MODEL_LEN, never two independent values.
# API tokenizer is mounted read-only at /models/llama; it does not load Llama weights.
VLLM_MAX_NUM_SEQS=2
VLLM_GPU_MEMORY_UTILIZATION=0.85

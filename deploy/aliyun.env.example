# Configuration template only. Copy to a private server-side file with mode 0600.
# Never commit the real file, print `docker compose config` without --quiet,
# or put model/application keys in a frontend build or a command argument.
ALIYUN_API_IMAGE=occupational-health-api:REPLACE_WITH_VERIFIED_VERSION
ALIYUN_WEB_IMAGE=occupational-health-web:REPLACE_WITH_VERIFIED_VERSION

# Must be an ALREADY mounted separate persistent filesystem, not the 30 GiB / disk.
# User approved the identified empty disk for initialization; confirm actual mount
# after that separate, root-managed step. This profile never formats or mounts disks.
ALIYUN_DATA_ROOT=/mnt/REPLACE_WITH_CONFIRMED_DATA_MOUNT
RAG_CORPUS_HOST_PATH=/mnt/REPLACE_WITH_CONFIRMED_DATA_MOUNT/zhiwei/corpus/immutable-export
RAG_UPLOADS_HOST_PATH=/mnt/REPLACE_WITH_CONFIRMED_DATA_MOUNT/zhiwei/private/uploads

# Planned separate HTTP ingress: / -> existing 3000, /zhiwei/ -> loopback 8080.
# Existing port 80 is not listening per the latest root-side inspection.
# The following origin/path are preparation values, not an already installed route.
RAG_PUBLIC_ORIGIN=https://REPLACE_WITH_EXISTING_APPROVED_HOST
ALIYUN_BASE_PATH=/zhiwei/
RAG_WEB_PORT=8080
RAG_API_KEY=REPLACE_WITH_RANDOM_HEX_AT_LEAST_32_CHARACTERS

# Application-allowed external endpoint is PENDING. Token Plan PERSONAL credentials
# must not be used for this website backend (official usage restriction).
# No actual API key is stored here. Model name is user-selected; its availability
# in the legally usable endpoint/account/region is not yet confirmed.
# Ollama native endpoint: https://<protected-host> (no /api/chat suffix).
# OpenAI-compatible endpoint: https://<protected-host>/v1.
# localhost here means INSIDE the API container and is not the user's laptop.
RAG_LLM_PROVIDER=openai_compatible
RAG_LLM_BASE_URL=https://REPLACE_WITH_APPLICATION_ALLOWED_MODEL_HOST/v1
RAG_LLM_MODEL=deepseek-v4.1-flash
RAG_LLM_API_KEY=
# Only for a confirmed private-network model URL; never public plaintext HTTP.
ALIYUN_ALLOW_PRIVATE_HTTP_MODEL=false

RAG_LLM_TIMEOUT_SECONDS=180
RAG_LLM_MAX_TOKENS=512
RAG_LLM_CONTEXT_CHARS=3500
RAG_LLM_CONTEXT_WINDOW=4096
RAG_TOP_K=2
RAG_CANDIDATE_K=8
RAG_RETRIEVAL_TIMEOUT_SECONDS=8
RAG_RATE_LIMIT_PER_MINUTE=20

# Local functional profile. Example only: no real key and no automatic service startup.
# Ollama must already contain this exact model; no pull/weight conversion is performed.
RAG_LLM_PROVIDER=ollama
RAG_LLM_BASE_URL=http://127.0.0.1:11434
RAG_LLM_MODEL=llama3.1:8b
RAG_LLM_CONTEXT_WINDOW=4096
RAG_LLM_MAX_TOKENS=512
RAG_LLM_TIMEOUT_SECONDS=180
RAG_LLM_CONTEXT_CHARS=3500
RAG_MAX_CONCURRENT_GENERATIONS=1
RAG_TOP_K=2
RAG_CANDIDATE_K=8
RAG_CORPUS_ROOT=E:/医学检索库_完整_20261010
# Explicitly single route for the current functional smoke; not hybrid acceptance.
RAG_RETRIEVAL_MODE=bm25
RAG_ALLOW_DEGRADED_RETRIEVAL=false
# No API key permits only loopback clients. Public deployment requires protected keys/HTTPS.
# Never put an Alibaba password or a personal server credential in this file.

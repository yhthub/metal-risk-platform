# 后端API服务配置示例
# 复制此文件为 .env 并根据需要修改

# ===========================================
# 服务配置
# ===========================================
APP_NAME=职业金属复合暴露智能干预推荐与决策支持系统
APP_VERSION=1.0.0
DEBUG=true

# ===========================================
# 服务器配置
# ===========================================
HOST=0.0.0.0
PORT=8000

# ===========================================
# CORS跨域配置
# ===========================================
# 允许跨域访问的源列表（逗号分隔）
# 开发环境默认值：http://localhost:3000,http://localhost:3001
# 生产环境请修改为实际的前端域名
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# 是否允许携带凭证（cookies、Authorization头等）
CORS_ALLOW_CREDENTIALS=true

# 允许的HTTP方法（逗号分隔，或使用 * 表示全部）
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH

# 允许的请求头（逗号分隔，或使用 * 表示全部）
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With,Accept,Origin

# 暴露给前端的响应头（逗号分隔）
CORS_EXPOSE_HEADERS=Content-Disposition,X-Request-Id,X-Process-Time

# 预检请求缓存时间（秒）
CORS_MAX_AGE=3600

# ===========================================
# 文件上传配置
# ===========================================
UPLOAD_DIR=data/uploads
MAX_FILE_SIZE=10485760  # 10MB

# ===========================================
# 数据库配置（暂未启用）
# ===========================================
# DATABASE_URL=postgresql://user:password@localhost:5432/occupational_health

# ===========================================
# Redis配置（暂未启用）
# ===========================================
# REDIS_URL=redis://localhost:6379

# ===========================================
# 日志配置
# ===========================================
LOG_LEVEL=INFO

# Environment example only. Do not put access keys in Git or frontend builds.
RAG_CORPUS_ROOT=E:/医学检索库_完整_20261010
RAG_RETRIEVAL_MODE=hybrid
RAG_ALLOW_DEGRADED_RETRIEVAL=false
# Independent MedCPT full-corpus index/runtime is required; BM25 rerank is not dual retrieval.
RAG_DENSE_BACKEND=faiss
# RAG_DENSE_INDEX_PATH=/absolute/path/to/verified-medcpt-index.faiss
# RAG_MEDCPT_QUERY_PATH=revision-directory-containing-config-and-weights
RAG_DENSE_MAX_INDEX_BYTES=536870912
RAG_DENSE_ALLOW_EXACT_SCAN=false
# Set whole-axis budget only after explicit resource planning, never as an API workaround.
RAG_RETRIEVAL_TIMEOUT_SECONDS=8
RAG_TOP_K=6
RAG_CANDIDATE_K=32
RAG_LLM_BASE_URL=http://127.0.0.1:8081/v1
RAG_LLM_MODEL=Llama-3.1-8B
RAG_LLM_TIMEOUT_SECONDS=180
RAG_LLM_MAX_TOKENS=768
RAG_LLM_CONTEXT_CHARS=12000
RAG_LLM_CONTEXT_WINDOW=4096
# RAG_LLM_TOKENIZER_PATH=/absolute/path/to/the-configured-Llama-tokenizer.json
RAG_MAX_CONCURRENT_GENERATIONS=1
RAG_RATE_LIMIT_PER_MINUTE=20
RAG_REQUIRE_API_KEY=false
RAG_ENABLE_UPLOAD_DOWNLOAD=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# RAG_API_KEY=configure-a-secret-outside-source-control
# RAG_LLM_API_KEY=configure-if-local-model-server-requires-it
